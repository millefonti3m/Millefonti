{
  "framework": "vite",
  "redirects": [
    {
      "source": "/",
      "destination": "/landing_millefonti.html",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/app", "destination": "/index.html" },
    { "source": "/(.+)", "destination": "/index.html" }
  ]
}
